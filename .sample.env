# .env de ejemplo para configuración de correo
# La contraseña de aplicación es una contraseña que se genera con google
# Y debe ser ingresada en el campo de AplicationPassword sin espacios ni guiones, solo los caracteres alfanuméricos.

SenderMail = "sample@example.com"
AplicationPassword = xxxxxxxxxxxxxxxx
SERVIDOR_SMTP = "smtp.gmail.com"
PUERTO = 587